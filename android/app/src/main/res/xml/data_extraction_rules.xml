<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior: ningún dato de la app (dibujos, progreso, preferencias,
     frases favoritas) se copia a la nube ni a otro teléfono al cambiar de dispositivo.
     En versiones anteriores lo impide android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
